APP_NAME="Expenses Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# JSON logs with a request id. Use LOG_CHANNEL=stack and LOG_STACK=json,single to mirror to a file.
LOG_CHANNEL=json
LOG_LEVEL=debug
LOG_JSON_STREAM=php://stderr

# SQLite by default; the engine is selected here only (no dialect-specific SQL in code).
DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Sanctum personal access tokens: lifetime in minutes (empty = never expire).
SANCTUM_EXPIRATION=43200

# Rate limits (attempts per minute).
THROTTLE_LOGIN_PER_MINUTE=5
THROTTLE_LOGIN_IP_PER_MINUTE=30
THROTTLE_REGISTER_PER_MINUTE=10
THROTTLE_API_PER_MINUTE=120
THROTTLE_STATS_PER_MINUTE=120
